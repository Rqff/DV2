{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": { "text": "Population trend by animal group", "subtitle": "PLACEHOLDER values. Click a legend entry to highlight one group" },
  "width": "container",
  "height": 300,
  "data": { "url": "data/PLACEHOLDER_trend.csv" },
  "params": [{ "name": "highlight", "select": { "type": "point", "fields": ["group"] }, "bind": "legend" }],
  "mark": { "type": "line", "point": true, "strokeWidth": 3 },
  "encoding": {
    "x": { "field": "year", "type": "quantitative", "axis": { "format": "d" }, "title": null },
    "y": { "field": "index", "type": "quantitative", "title": "Population size (1970 = 100)" },
    "color": { "field": "group", "type": "nominal", "title": "Animal group" },
    "opacity": { "condition": { "param": "highlight", "value": 1 }, "value": 0.15 },
    "tooltip": [
      { "field": "group", "type": "nominal", "title": "Group" },
      { "field": "year", "type": "quantitative", "title": "Year", "format": "d" },
      { "field": "index", "type": "quantitative", "title": "Index" }
    ]
  }
}
